# Copy to .env.local (git-ignored) and fill in from Supabase → Project Settings → API.
# Also add both to Vercel → Project → Settings → Environment Variables.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The public key: the legacy "anon" key, or the newer "publishable" key (sb_publishable_...).
# Never put the service-role / secret key here or anywhere in the frontend.
VITE_SUPABASE_ANON_KEY=
