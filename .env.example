# Optional. The app's public Supabase settings are in .env (committed).
# To point a local copy at a different Supabase project, copy this to .env.local (git-ignored).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The public key: the publishable key (sb_publishable_...) or the legacy anon key.
# Never put the secret / service-role key here or anywhere in the frontend.
VITE_SUPABASE_ANON_KEY=
