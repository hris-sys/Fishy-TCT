{
  "name": "tankmates",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "db:check": "supabase db query --linked -f supabase/tests/access.sql",
    "db:push": "supabase db push --linked",
    "tank:new": "node scripts/new-tank.mjs",
    "check:outsider": "node scripts/check-outsider.mjs"
  },
  "devDependencies": {
    "@tweakpane/core": "^2.0.5",
    "supabase": "^2.122.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "pixi.js": "^8.22.0",
    "tweakpane": "^4.0.5"
  }
}
